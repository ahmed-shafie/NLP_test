# Banking NLU Brain — example configuration. Copy to `.env` and adjust.
# All variables use the NLU_ prefix.

# ---- Core models ----
NLU_PRELOAD_MODELS=false
NLU_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NLU_SEMANTIC_INTENT_THRESHOLD=0.45
NLU_CONTACT_MATCH_THRESHOLD=0.5
# Points the best fuzzy name match must lead the runner-up by before a spelling is
# corrected. Lowering it lets "Noura" be "corrected" into the different name
# "Nouran" — i.e. a transfer that names someone else.
NLU_NAME_MATCH_MARGIN=5.0
# Higher confidence bar before the semantic net labels a turn INAPPROPRIATE, so
# legitimate-but-nearby words (e.g. "المخالفة" = a fine) are not over-blocked.
NLU_MODERATION_SEMANTIC_THRESHOLD=0.80

# ---- LLM exception handler (local Ollama by default) ----
NLU_LLM_ENABLED=true
NLU_LLM_MODEL=ollama/qwen2.5:3b
NLU_LLM_API_BASE=http://localhost:11434

# ---- Reply phrasing (two tiers: money-critical vs conversational) ----
# Rotate between the hand-written phrasings of a conversational reply.
NLU_REPLY_VARIATION_ENABLED=true
# Let the local model re-word CONVERSATIONAL replies only. Off by default;
# money-critical replies (confirmations, amounts, IBANs, results) are never rewritten.
NLU_REPLY_REWRITE_ENABLED=false
NLU_REPLY_REWRITE_TIMEOUT=0.8

# ---- Contextual answers for refused questions ----
# Answer "why was I charged twice?" about its own subject instead of the generic
# "transfer or bill?" menu, using the topic of the retrieved corpus rows. Replies
# are hand-written; the gate below decides when the retrieval is trusted.
NLU_TOPIC_REPLIES_ENABLED=true
# Calibrated on the held-out slice: 14.9% of customer-service questions answered
# in context, 1.4% of those about the wrong subject. Loosening to k=5 / 0.90
# reaches ~25% coverage at ~4% wrong answers.
NLU_TOPIC_REPLY_TOP_K=10
NLU_TOPIC_REPLY_AGREEMENT=0.8
NLU_TOPIC_REPLY_THRESHOLD=0.94
NLU_TOPIC_REPLY_UNANIMOUS_THRESHOLD=0.74

# ---- Beneficiary database lookup (env fallback; GUI connections take precedence) ----
NLU_DB_ENABLED=false
# NLU_DB_URL=postgresql+psycopg://user:pass@host:5432/bank

# ---- Request limits ----
NLU_MAX_REQUEST_BYTES=1000000

# ---- Audit + ELK observability ----
NLU_AUDIT_ENABLED=true
NLU_AUDIT_SINK=elasticsearch
# Ship audit events on a background thread (keeps network I/O off the request path).
NLU_AUDIT_ASYNC=true
NLU_ELK_ENABLED=true
NLU_ELASTICSEARCH_URL=http://localhost:9200
# NLU_ELASTICSEARCH_USERNAME=
# NLU_ELASTICSEARCH_PASSWORD=

# ---- Logging & metrics ----
NLU_LOG_LEVEL=INFO
NLU_LOG_JSON=true
NLU_METRICS_ENABLED=true

# ---- Conversation (multi-turn slot filling) ----
NLU_CONVERSATION_ENABLED=true
# Session backend: "memory" (single process) or "redis" (shared). Auto-falls back
# to memory when Redis is unreachable.
NLU_SESSION_BACKEND=memory
NLU_REDIS_URL=redis://localhost:6379/0
NLU_SESSION_TTL_SECONDS=1800

# ---- Memory Brain (per-user habits + shortcuts; SQL + Redis cache) ----
NLU_MEMORY_ENABLED=true
# Durable store (any SQLAlchemy provider). Defaults to a local SQLite file.
NLU_MEMORY_STORE_URL=sqlite:///./memory_brain.db
# Read cache: "memory" (process-local) or "redis" (shared, reuses NLU_REDIS_URL).
NLU_MEMORY_CACHE_BACKEND=memory
NLU_MEMORY_CACHE_TTL_SECONDS=900
# Completed transfers to a recipient before it becomes a learned favourite default.
NLU_MEMORY_FAVORITE_MIN_COUNT=2

# ---- Banking Core integration (separate service on ~:8100) ----
# API-backed cases: balance inquiry, transfer/bill pre-flight, add beneficiary.
# Disabled by default so tests stay hermetic; enable for the live demo.
NLU_BANKING_CORE_ENABLED=false
NLU_BANKING_CORE_URL=http://localhost:8100
# NLU_BANKING_CORE_API_KEY=
NLU_BANKING_CORE_TIMEOUT=10.0

# Beneficiary *lookup* for transfers is a direct DB read (NOT the API): a matching
# first name across several people triggers a "which one?" disambiguation turn.
NLU_BENEFICIARY_LOOKUP_ENABLED=false
# SQLite keeps local development zero-setup. Point this at the same Postgres the
# Banking Core service uses to read beneficiaries from there instead:
#   NLU_BENEFICIARY_DB_URL=postgresql+psycopg://banking:banking@localhost:5432/banking_core
NLU_BENEFICIARY_DB_URL=sqlite:///./banking-core/banking_core.db
NLU_BENEFICIARY_TABLE=beneficiaries
NLU_BENEFICIARY_OWNER_COLUMN=owner_user

# --- Banking Core database (accounts, beneficiaries, billers) ----------------
# Read by the Banking Core service itself (prefix BANKING_CORE_). Postgres is
# the deployment target; docker compose provisions it automatically.
# BANKING_CORE_DB_URL=postgresql+psycopg://banking:banking@localhost:5432/banking_core
# Load the demo rows when the database is still empty (never overwrites data).
# BANKING_CORE_SEED_ON_STARTUP=true
