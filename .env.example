# aiapply_lite configuration - copy to .env and edit as needed.
# Everything works out of the box with local Ollama and keyless job sources.

# --- Local LLM (Ollama) ---
OLLAMA_BASE_URL=http://localhost:11434
AIAPPLY_LLM_MODEL=qwen2.5:3b
AIAPPLY_EMBED_MODEL=nomic-embed-text
AIAPPLY_LLM_TIMEOUT=120

# --- Job data sources (comma-separated): remotive,remoteok,adzuna,mock ---
AIAPPLY_JOB_SOURCES=remotive,remoteok

# --- Adzuna (optional, official free API): https://developer.adzuna.com/ ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb

# --- Tavily web search for company research (optional): https://tavily.com/ ---
TAVILY_API_KEY=

# --- Storage ---
# AIAPPLY_DATA_DIR=/absolute/path/to/data
