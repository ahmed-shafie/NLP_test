# Banking NLU Brain — example configuration. Copy to `.env` and adjust.
# All variables use the NLU_ prefix.

# ---- Core models ----
NLU_PRELOAD_MODELS=false
NLU_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
NLU_SEMANTIC_INTENT_THRESHOLD=0.45
NLU_CONTACT_MATCH_THRESHOLD=0.5
# Higher confidence bar before the semantic net labels a turn INAPPROPRIATE, so
# legitimate-but-nearby words (e.g. "المخالفة" = a fine) are not over-blocked.
NLU_MODERATION_SEMANTIC_THRESHOLD=0.80

# ---- LLM exception handler (local Ollama by default) ----
NLU_LLM_ENABLED=true
NLU_LLM_MODEL=ollama/qwen2.5:3b
NLU_LLM_API_BASE=http://localhost:11434

# ---- Beneficiary database lookup (env fallback; GUI connections take precedence) ----
NLU_DB_ENABLED=false
# NLU_DB_URL=postgresql+psycopg://user:pass@host:5432/bank

# ---- Request limits ----
NLU_MAX_REQUEST_BYTES=1000000

# ---- Audit + ELK observability ----
NLU_AUDIT_ENABLED=true
NLU_AUDIT_SINK=elasticsearch
# Ship audit events on a background thread (keeps network I/O off the request path).
NLU_AUDIT_ASYNC=true
NLU_ELK_ENABLED=true
NLU_ELASTICSEARCH_URL=http://localhost:9200
# NLU_ELASTICSEARCH_USERNAME=
# NLU_ELASTICSEARCH_PASSWORD=

# ---- Logging & metrics ----
NLU_LOG_LEVEL=INFO
NLU_LOG_JSON=true
NLU_METRICS_ENABLED=true

# ---- Conversation (multi-turn slot filling) ----
NLU_CONVERSATION_ENABLED=true
# Session backend: "memory" (single process) or "redis" (shared). Auto-falls back
# to memory when Redis is unreachable.
NLU_SESSION_BACKEND=memory
NLU_REDIS_URL=redis://localhost:6379/0
NLU_SESSION_TTL_SECONDS=1800

# ---- Memory Brain (per-user habits + shortcuts; SQL + Redis cache) ----
NLU_MEMORY_ENABLED=true
# Durable store (any SQLAlchemy provider). Defaults to a local SQLite file.
NLU_MEMORY_STORE_URL=sqlite:///./memory_brain.db
# Read cache: "memory" (process-local) or "redis" (shared, reuses NLU_REDIS_URL).
NLU_MEMORY_CACHE_BACKEND=memory
NLU_MEMORY_CACHE_TTL_SECONDS=900
# Completed transfers to a recipient before it becomes a learned favourite default.
NLU_MEMORY_FAVORITE_MIN_COUNT=2
