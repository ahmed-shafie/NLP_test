digraph voice_flow {
  rankdir=TB;
  graph [fontname="Helvetica", fontsize=12, bgcolor="white", nodesep=0.35, ranksep=0.5];
  node  [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", color="#334155", fillcolor="#e2e8f0"];
  edge  [fontname="Helvetica", fontsize=10, color="#475569"];

  subgraph cluster_browser {
    label="Browser  (/voice page)";
    labeljust="l";
    color="#94a3b8"; fontcolor="#475569"; style="rounded";
    mic   [label="Microphone\n(MediaRecorder)", fillcolor="#bae6fd"];
    play  [label="Play spoken reply\n(audio element)", fillcolor="#bae6fd"];
    ui    [label="Render transcript,\nslots, status", fillcolor="#bae6fd"];
  }

  subgraph cluster_api {
    label="FastAPI  POST /conversation/voice  (async, run_in_threadpool)";
    labeljust="l";
    color="#94a3b8"; fontcolor="#475569"; style="rounded";
    asr   [label="ASR\nfaster-whisper\n(speech -> text)", fillcolor="#ddd6fe"];
    eng   [label="ConversationEngine.handle()\nNLU + slot-filling state machine", fillcolor="#bbf7d0"];
    tts   [label="TTS\nedge-tts -> pyttsx3\n(text -> speech)", fillcolor="#ddd6fe"];
  }

  store [label="Session store\nRedis -> in-memory fallback", shape=cylinder, fillcolor="#fde68a"];

  mic   -> asr   [label="audio (webm/opus)"];
  asr   -> eng   [label="transcript"];
  eng   -> store [label="load / save state", dir=both, style=dashed];
  eng   -> tts   [label="reply text"];
  tts   -> play  [label="base64 audio"];
  eng   -> ui    [label="reply, slots, status"];
}
